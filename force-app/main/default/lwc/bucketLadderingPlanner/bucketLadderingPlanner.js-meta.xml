<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Finance - Bucket Laddering Planner</masterLabel>
    <description>Retirement corpus laddering planner with accumulation, decumulation, and planned expense projections.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property
                name="defaultCurrencyCode"
                type="String"
                default="USD"
                datasource="USD,INR,EUR"
                label="Default Currency"
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
